# Application connection. May point to PgBouncer in transaction-pooling mode.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Direct PostgreSQL connection for Prisma migrations/introspection.
# Without PgBouncer, use the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
# Admin bootstrap only. Do not commit real credentials.
ADMIN_NAME="VEXAUSE Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
# Razorpay test/live credentials. Keep secrets only in the VPS environment; never commit real values.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-a-separate-webhook-secret"
# Configure the Razorpay webhook URL as https://YOUR_DOMAIN/api/webhooks/razorpay
# Subscribe to payment.captured and order.paid events.

# Product images are stored on the VPS in public/uploads/products.
# Keep this directory on persistent disk and include it in off-server backups.

# Public canonical site origin, e.g. https://vexause.com
NEXT_PUBLIC_SITE_URL=
# Optional comma-separated additional trusted browser origins (include scheme).
TRUSTED_ORIGINS=

# Private customer CAD/reference/design uploads (outside public web root).
PRIVATE_UPLOAD_DIR="/var/lib/vexause/private-uploads"

# SMTP account email delivery (worker service). Keep credentials private on the VPS.
SMTP_HOST=
SMTP_PORT="587"
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="VEXAUSE LABS <no-reply@YOUR_DOMAIN>"

# Google OAuth Web application credentials.
# Authorized redirect URI must exactly match: https://YOUR_DOMAIN/api/customer/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Background worker polling interval in milliseconds (default: 5000).
WORKER_POLL_MS="5000"
